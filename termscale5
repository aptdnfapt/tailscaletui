#!/bin/bash

# --- Configuration ---
# Feel free to change these color codes (0-255)
# Reference: https://github.com/charmbracelet/gum#colors
readonly GUM_COLOR_BORDER_DEFAULT=212 # Light purple (Less used now for main header)
readonly GUM_COLOR_BORDER_STATUS=57   # Medium blue
readonly GUM_COLOR_BORDER_ACTION=69   # Aqua
readonly GUM_COLOR_BORDER_EXITNODE=93 # Violet
readonly GUM_COLOR_BORDER_SEARCH=57   # Medium blue
readonly GUM_COLOR_BORDER_INFO=87     # Another nice blue/purple for IP check
readonly GUM_COLOR_FG_SUCCESS=10      # Green
readonly GUM_COLOR_FG_ERROR=9         # Red
readonly GUM_COLOR_FG_WARN=11         # Yellow
readonly GUM_COLOR_FG_INFO=12         # Blue
readonly GUM_COLOR_FG_CYAN=14         # Cyan
readonly GUM_COLOR_FG_MUTED=240       # Grey
readonly GUM_COLOR_FG_HIGHLIGHT=33    # Bright blue for current exit node info

# ANSI Colors for direct echo/printf
readonly ANSI_GREEN=$(printf '\033[32m')
readonly ANSI_RED=$(printf '\033[31m')
readonly ANSI_YELLOW=$(printf '\033[33m')
readonly ANSI_BLUE=$(printf '\033[34m')
readonly ANSI_CYAN=$(printf '\033[36m')
readonly ANSI_RESET=$(printf '\033[0m')
readonly ANSI_BOLD=$(printf '\033[1m')

# Timeout for curl operations (seconds)
readonly CURL_TIMEOUT=7

# --- Helper Functions ---

# Clear screen without affecting scrollback
clear_viewport() {
    printf '\033[2J\033[H'
}

# Check for required commands
check_dependency() {
  local cmd=$1
  local install_url=$2
  if ! command -v "$cmd" &>/dev/null; then
    # Use echo directly here as gum might not be available yet
    echo "${ANSI_BOLD}${ANSI_RED}${cmd} could not be found.${ANSI_RESET}" >&2
    echo "Please install it first: ${install_url}" >&2
    exit 1
  fi
}

# Display a styled header (for sub-sections)
display_header() {
  local title="$1"
  local color="${2:-$GUM_COLOR_BORDER_DEFAULT}"
  # Add some top margin before the header
  echo ""
  gum style --border double --margin "1" --padding "1 2" --border-foreground "$color" "$title"
  echo # Add a newline for spacing after header
}

# Display a styled message
display_message() {
  local color="$1"
  shift
  local message="$@"
  gum style --bold --foreground "$color" "$message"
  sleep 1 # Give user time to read
}

# Run a command with a spinner and display success/error
run_with_spinner() {
  local title="$1"
  local success_msg="$2"
  local failure_msg="$3"
  shift 3
  local cmd=("${@}")

  # Add a newline before spinner for spacing
  echo ""
  if gum spin --spinner dot --title "$title" --show-output -- "${cmd[@]}"; then
    display_message "$GUM_COLOR_FG_SUCCESS" "$success_msg"
    return 0
  else
    display_message "$GUM_COLOR_FG_ERROR" "$failure_msg"
    return 1
  fi
}

# Pause script execution until Enter is pressed
press_enter_to_continue() {
    # Add some space before the prompt
    echo ""
    gum input --placeholder "Press Enter to return to main menu..." > /dev/null
}

# Fetch and display public IP info with timeout
fetch_and_display_ip_info() {
    local ip_info
    local curl_exit_code

    # Use gum spin for the curl command itself
    ip_info=$(gum spin --spinner dot --title "Fetching public IP info (max ${CURL_TIMEOUT}s)..." -- \
        curl -s --max-time "$CURL_TIMEOUT" ipinfo.io)
    curl_exit_code=$?

    echo # Newline after spinner

    if [[ $curl_exit_code -eq 0 ]] && [ -n "$ip_info" ]; then # Also check if output is not empty
        gum style --bold --foreground "$GUM_COLOR_FG_HIGHLIGHT" "Public IP Information (ipinfo.io):"
        if command -v jq &> /dev/null; then
            echo "$ip_info" | jq --color-output .
        else
            # Simple indenting for non-jq output
            echo "$ip_info" | sed 's/^/  /' | while IFS= read -r line; do echo -e "${ANSI_CYAN}$line${ANSI_RESET}"; done
        fi
        return 0 # Success
    elif [[ $curl_exit_code -eq 28 ]]; then # 28 is timeout error code for curl
        display_message "$GUM_COLOR_FG_ERROR" "Error: Could not fetch IP info (timeout after ${CURL_TIMEOUT}s)."
        return 1 # Failure
    else
        display_message "$GUM_COLOR_FG_ERROR" "Error: Failed to fetch IP info (curl exit code: $curl_exit_code)."
        return 1 # Failure
    fi
}


# --- Main Logic Functions ---

# Show enhanced Tailscale status
show_status() {
  clear_viewport # Use viewport clear
  display_header "Tailscale Status" "$GUM_COLOR_BORDER_STATUS"

  # Fetch status once
  local status_output
  status_output=$(tailscale status)
  local current_exit_node_line=$(echo "$status_output" | grep 'exit node; direct' | grep -v 'offers exit node')

  # Display current active exit node info if exists
  if [ -n "$current_exit_node_line" ]; then
    local exit_node_name=$(echo "$current_exit_node_line" | awk '{print $2}')
    local exit_node_ip=$(echo "$current_exit_node_line" | awk '{print $1}')
    local public_ip=$(echo "$current_exit_node_line" | grep -oE 'direct [^,;]+' | awk '{print $2}')

    gum style --foreground "$GUM_COLOR_FG_HIGHLIGHT" --bold "Current Active Exit Node:"
    echo "${ANSI_CYAN}${current_exit_node_line}${ANSI_RESET}"
    if [ -n "$public_ip" ]; then
      echo "${ANSI_BLUE}Public IP via ${exit_node_name}: ${public_ip}${ANSI_RESET}"
    fi
    echo ""
    echo "---" # Simple separator
    echo ""
  fi

  # Process status with colors and numbering
  local counter=1
  local online_count=0
  local offline_count=0
  local term_width=$(tput cols)
  local status_width=$((term_width > 15 ? term_width - 10 : term_width - 5 ))
  [[ $status_width -lt 20 ]] && status_width=20 # Ensure minimum width

  # Count online/offline first
  while IFS= read -r line; do
      [ -z "$line" ] && continue
      if [[ "$line" == *"offline"* ]]; then
          ((offline_count++))
      else
          ((online_count++))
      fi
  done <<< "$status_output"

  # Display numbered and colored status, wrapping lines
  echo "$status_output" | while IFS= read -r line; do
      [ -z "$line" ] && continue

      local color="$ANSI_GREEN" # Default to green
      if [[ "$line" == *"offline"* ]]; then color="$ANSI_RED"
      elif [[ "$line" == *"exit node; direct"* && ! "$line" == *"offers exit node"* ]]; then color="$ANSI_CYAN"
      elif [[ "$line" == *"offers exit node"* ]]; then color="$ANSI_YELLOW"
      fi

      echo "$line" | fold -w "$status_width" -s | sed "1s/^/${color}$(printf "%3d." "$counter") /; 2,\$s/^/    /; s/$/${ANSI_RESET}/"
      ((counter++))
  done

  echo ""
  local online_msg
  local offline_msg
  online_msg=$(gum style --foreground "$GUM_COLOR_FG_SUCCESS" "Online: $online_count")
  offline_msg=$(gum style --foreground "$GUM_COLOR_FG_ERROR" "Offline: $offline_count")
  gum join --align center --vertical "$online_msg" "$offline_msg"
  echo ""

  # Search functionality
  gum style --foreground "$GUM_COLOR_FG_MUTED" "Press '/' to search, or Enter to return to main menu..."
  read -n 1 -s key

  if [ "$key" = "/" ]; then
    clear_viewport # Use viewport clear
    display_header "Search Tailscale Status" "$GUM_COLOR_BORDER_SEARCH"
    local search_term
    search_term=$(gum input --placeholder "Enter search term...")

    if [ -n "$search_term" ]; then
      clear_viewport # Use viewport clear
      display_header "Search Results for: $search_term" "$GUM_COLOR_BORDER_SEARCH"
      tailscale status | grep -Ei "$search_term" | while IFS= read -r line; do # Use -E for better regex, -i case-insensitive
        local color="$ANSI_GREEN"
        if [[ "$line" == *"offline"* ]]; then color="$ANSI_RED";
        elif [[ "$line" == *"exit node; direct"* && ! "$line" == *"offers exit node"* ]]; then color="$ANSI_CYAN";
        elif [[ "$line" == *"offers exit node"* ]]; then color="$ANSI_YELLOW"; fi
        echo -e "${color}${line}${ANSI_RESET}"
      done
      press_enter_to_continue
    else
       # If search term is empty, just go back
       main_menu
    fi
  elif [ -z "$key" ]; then # Handles pressing Enter directly
      : # Do nothing, proceed to main_menu
  fi

  main_menu
}

# Enable Tailscale
enable_tailscale() {
  clear_viewport # Use viewport clear
  display_header "Enabling Tailscale" "$GUM_COLOR_BORDER_ACTION"
  run_with_spinner "Running tailscale up..." \
    "Tailscale enabled successfully!" \
    "Failed to enable Tailscale." \
    tailscale up
  sleep 1
  main_menu
}

# Disable Tailscale
disable_tailscale() {
  clear_viewport # Use viewport clear
  display_header "Disabling Tailscale" "$GUM_COLOR_BORDER_ACTION"
  run_with_spinner "Running tailscale down..." \
    "Tailscale disabled successfully!" \
    "Failed to disable Tailscale." \
    tailscale down
  sleep 1
  main_menu
}

# Restart Tailscale
restart_tailscale() {
  clear_viewport # Use viewport clear
  display_header "Restarting Tailscale" "$GUM_COLOR_BORDER_ACTION"
  run_with_spinner "Running tailscale down && tailscale up..." \
    "Tailscale restarted successfully!" \
    "Failed to restart Tailscale." \
    bash -c "tailscale down && tailscale up" # Need bash -c for &&
  sleep 1
  main_menu
}

# Set exit node with search functionality
set_exit_node() {
  clear_viewport # Use viewport clear
  display_header "Select Exit Node" "$GUM_COLOR_BORDER_EXITNODE"

  # Display current *active* exit node using tailscale status
  gum style --foreground "$GUM_COLOR_FG_HIGHLIGHT" --bold "Checking current active exit node..."
  local active_node_line
  active_node_line=$(tailscale status | grep 'exit node; direct' | grep -v 'offers exit node')

  if [ -n "$active_node_line" ]; then
      echo -e "${ANSI_BLUE}Current Active Exit Node: ${active_node_line}${ANSI_RESET}"
  else
      gum style --foreground "$GUM_COLOR_FG_MUTED" "Current Status: No exit node actively routing traffic."
  fi
  echo ""
  echo "------------------------------------"
  echo ""


  # Get list of online nodes offering exit node capability
  local exit_nodes_raw
  exit_nodes_raw=$(tailscale status | grep 'offers exit node' | grep -v "offline" | awk '{printf "%s %s (%s)\n", $1, $2, $3}')

  if [ -z "$exit_nodes_raw" ]; then
    display_message "$GUM_COLOR_FG_WARN" "No online exit nodes available to select."
    sleep 1
    main_menu
    return
  fi

  # Prepare choices for gum filter, adding special options
  local choices=$(echo "$exit_nodes_raw" ; echo "[ Clear exit node ]" ; echo "[ Back to menu ]")

  local selected
  selected=$(echo "$choices" | gum filter --header="Available Exit Nodes (Online only):" --placeholder="Type to search..." --height=15)

  # Handle special selections
  case "$selected" in
    "[ Back to menu ]" | "") # Also handle empty selection (ESC)
      main_menu
      return
      ;;
    "[ Clear exit node ]")
      clear_exit_node # Call the dedicated function
      return # clear_exit_node will return to main_menu
      ;;
  esac

  # Extract IP and Name from the selected node
  local exit_node_ip=$(echo "$selected" | awk '{print $1}')
  local exit_node_name=$(echo "$selected" | awk '{print $2}')

  clear_viewport # Use viewport clear
  display_header "Setting Exit Node" "$GUM_COLOR_BORDER_ACTION"
  if run_with_spinner "Setting exit node to $exit_node_name ($exit_node_ip)..." \
     "Exit node set successfully!" \
     "Failed to set exit node." \
     tailscale set --exit-node="$exit_node_ip"; then

    echo ""
    gum style --bold --foreground "$GUM_COLOR_FG_HIGHLIGHT" "Verifying new exit node status..."
    sleep 1
    local new_exit_info=$(tailscale status | grep "$exit_node_ip.*exit node; direct")
    local ip_fetch_successful=1

    if [ -n "$new_exit_info" ]; then
        echo "${ANSI_CYAN}${new_exit_info}${ANSI_RESET}"
        echo ""
        if fetch_and_display_ip_info; then
           ip_fetch_successful=0
        fi
    else
        display_message "$GUM_COLOR_FG_WARN" "Could not immediately verify exit node status via 'tailscale status'. Check 'Status' manually."
        echo ""
        if fetch_and_display_ip_info; then
            ip_fetch_successful=0
        fi
    fi

    if [ "$ip_fetch_successful" -eq 0 ]; then
        press_enter_to_continue
    else
        sleep 2
    fi

  else
      sleep 2
  fi

  main_menu
}

# Clear exit node
clear_exit_node() {
  clear_viewport # Use viewport clear
  display_header "Clearing Exit Node" "$GUM_COLOR_BORDER_ACTION"
  run_with_spinner "Running tailscale set --exit-node= ..." \
    "Exit node cleared successfully!" \
    "Failed to clear exit node." \
    tailscale set --exit-node=
  sleep 1
  main_menu
}

# Check Public IP
check_public_ip() {
  clear_viewport # Use viewport clear
  display_header "Check Public IP Address" "$GUM_COLOR_BORDER_INFO"
  if fetch_and_display_ip_info; then
      press_enter_to_continue
  else
      sleep 2
  fi
  main_menu
}


# Main menu function
main_menu() {
  clear_viewport # Use viewport clear instead of full clear

  # ASCII Art Header
  echo "" # Add some top padding
  echo -e "  ${ANSI_BLUE}o${ANSI_RESET} ${ANSI_BLUE}o${ANSI_RESET} ${ANSI_BLUE}o${ANSI_RESET}"
  echo -e "  ${ANSI_YELLOW}*${ANSI_RESET} ${ANSI_YELLOW}*${ANSI_RESET} ${ANSI_YELLOW}*${ANSI_RESET}   ${ANSI_BOLD}${ANSI_CYAN}Tailscale Manager${ANSI_RESET}"
  echo -e "  ${ANSI_BLUE}o${ANSI_RESET} ${ANSI_YELLOW}*${ANSI_RESET} ${ANSI_BLUE}o${ANSI_RESET}"
  echo "" # Add space after header

  local choice
  choice=$(gum choose --header="Select an option:" --height=10 \
    "Status" \
    "Enable Tailscale" \
    "Disable Tailscale" \
    "Restart Tailscale" \
    "Set Exit Node" \
    "Clear Exit Node" \
    "Check Public IP" \
    "Exit")

  case "$choice" in
    "Status") show_status ;;
    "Enable Tailscale") enable_tailscale ;;
    "Disable Tailscale") disable_tailscale ;;
    "Restart Tailscale") restart_tailscale ;;
    "Set Exit Node") set_exit_node ;;
    "Clear Exit Node") clear_exit_node ;;
    "Check Public IP") check_public_ip ;;
    "Exit")
      # No need to clear here, just exit
      echo ""
      gum style --bold --foreground "$GUM_COLOR_FG_INFO" "Exiting Tailscale Manager."
      exit 0
      ;;
    *) # Handle ESC or empty selection
      echo ""
      gum style --bold --foreground "$GUM_COLOR_FG_INFO" "Exiting Tailscale Manager."
      exit 0
      ;;
  esac
}

# --- Script Entry Point ---

# Check dependencies first
check_dependency "gum" "https://github.com/charmbracelet/gum"
check_dependency "tailscale" "https://tailscale.com/download"
check_dependency "tput" "Part of ncurses, usually pre-installed."
check_dependency "awk" "Standard Unix utility, usually pre-installed."
check_dependency "fold" "Standard Unix utility, usually pre-installed."
check_dependency "curl" "Standard utility, usually pre-installed."
check_dependency "grep" "Standard utility, usually pre-installed."
check_dependency "sed" "Standard utility, usually pre-installed."

# Initial check for jq (optional)
if ! command -v jq &>/dev/null; then
    echo "$(gum style --foreground $GUM_COLOR_FG_WARN "Optional:") 'jq' not found. IP info output will be plain text."
    sleep 1 # Brief pause to notice the message
fi


# Run main menu loop
while true; do
  main_menu
done
